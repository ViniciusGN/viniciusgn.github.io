---
import type { Experience } from "../data/experience";
import "../styles/ExperienceItem.css";

interface Props {
  entry: Experience;
}

const { entry } = Astro.props;

const typeColors = {
  academia: { bg: "#EFF6FF", text: "#1D4ED8", border: "#BFDBFE" },
  company:  { bg: "#F0FDF4", text: "#166534", border: "#BBF7D0" },
  other:    { bg: "#FFF7ED", text: "#9A3412", border: "#FED7AA" },
};

const colors = typeColors[entry.type];

const descriptions = Array.isArray(entry.description)
  ? entry.description
  : [entry.description];
---

<div class="exp-item">
  <a
    href={entry.url}
    target="_blank"
    rel="noopener"
    class="exp-logo"
    aria-label={`Visit ${entry.organization}`}
    style={`background:${colors.bg}; color:${colors.text}; border-color:${colors.border};`}
  >
    {
      entry.logo ? (
        <img src={entry.logo} alt={`${entry.organization} logo`} />
      ) : (
        entry.initials
      )
    }
  </a>

  <div class="exp-content">
    <div class="exp-header">
      <span class="exp-role">{entry.role}</span>
      <span class="exp-period">{entry.period}</span>
    </div>

    <a href={entry.url} target="_blank" rel="noopener" class="exp-org">
      {entry.organization}
    </a>

    <ul class="exp-desc">
      {descriptions.map(item => (
        <li>{item}</li>
      ))}
    </ul>

    <div class="exp-tags">
      {entry.tags.map(tag => <span class="chip">{tag}</span>)}
    </div>
  </div>
</div>