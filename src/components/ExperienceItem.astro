---
import type { Experience } from "../data/experience";
import "../styles/ExperienceItem.css";

interface Props {
  entry: Experience;
}

const { entry } = Astro.props;

const typeClass = {
  academia: "logo-academia",
  company:  "logo-company",
  other:    "logo-other",
};

const descriptions = Array.isArray(entry.description)
  ? entry.description
  : [entry.description];
---

<div class="exp-item">
  <a
  href={entry.url}
    target="_blank"
    rel="noopener"
    class={`exp-logo ${entry.logo ? 'logo-has-image' : typeClass[entry.type]}`}
    aria-label={`Visit ${entry.organization}`}
  >
    {entry.logo
      ? <img src={entry.logo} alt={`${entry.organization} logo`} />
      : entry.initials
    }
  </a>

  <div class="exp-content">
    <div class="exp-header">
      <span class="exp-role">{entry.role}</span>
      <span class="exp-period">{entry.period}</span>
    </div>

    <a href={entry.url} target="_blank" rel="noopener" class="exp-org">
      {entry.organization}
    </a>

    <ul class="exp-desc">
      {descriptions.map(item => <li>{item}</li>)}
    </ul>

    <div class="exp-tags">
      {entry.tags.map(tag => <span class="tag">{tag}</span>)}
    </div>
  </div>
</div>

<style>
  /* Institution logo colors via CSS classes — dark mode safe */
  .logo-academia {
    background: var(--inst-academia-bg);
    color: var(--inst-academia-text);
    border-color: var(--inst-academia-border) !important;
  }
  .logo-company {
    background: var(--inst-company-bg);
    color: var(--inst-company-text);
    border-color: var(--inst-company-border) !important;
  }
  .logo-other {
    background: var(--inst-other-bg);
    color: var(--inst-other-text);
    border-color: var(--inst-other-border) !important;
  }
  .logo-has-image {
  background: var(--bg);
  border-color: var(--accent-border) !important;
  }
</style>