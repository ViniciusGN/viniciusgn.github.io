---
// ProjectCard.astro — clickable card with bounding-box hover + modal trigger
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;

const CATEGORY_TAGS = ["AI", "Cybersecurity", "AI Security", "Others"];

const categoryTags  = project.tags.filter(t => CATEGORY_TAGS.includes(t));
const technicalTags = project.tags.filter(t => !CATEGORY_TAGS.includes(t));
---

<div
  class="bb-card project-card"
  role="button"
  aria-label={`Open details for ${project.title}`}
  data-modal-title={project.title}
  data-modal-description={project.fullDescription}
  data-modal-color={project.color}
  data-modal-tags={project.tags.join(",")}
  data-modal-github={project.githubUrl}
  data-modal-has-demo={String(project.hasDemo)}
  data-modal-demo-url={project.demoUrl}
>
  <div class="card-header">
    <div class="card-title-row">
      <!-- Colored dot -->
      <span class="project-dot" style={`background:${project.color}`}></span>
      <span class="project-title">{project.title}</span>
    </div>
    <span class="project-year">{project.year}</span>
  </div>

  <p class="project-desc">{project.description}</p>

  <div class="card-tags">
    {technicalTags.map(tag => <span class="chip">{tag}</span>)}
    {categoryTags.map(tag  => <span class="chip chip-accent">{tag}</span>)}
    {project.hasDemo && (
      <span class="chip chip-demo">
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
          <polyline points="15 3 21 3 21 9"/>
          <line x1="10" y1="14" x2="21" y2="3"/>
        </svg>
        interactive demo
      </span>
    )}
  </div>
</div>

<style>
  .project-card {
    padding: 16px 18px;
    margin-bottom: 8px;
    background: #fff;
    transition: border-color 0.15s;
  }

  .dark .project-card {
    background: var(--surface);
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 8px;
  }

  .card-title-row {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .project-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .project-title {
    font-size: 14px;
    font-weight: 500;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .project-year {
    font-size: 12px;
    color: var(--text-tertiary);
    flex-shrink: 0;
  }

  .project-desc {
    font-size: 12px;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 12px;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }
</style>
