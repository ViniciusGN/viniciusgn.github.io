---
// Projects.astro — homepage projects section
// Shows all projects with search + filter. Links to /projects for full detail page.
import ProjectCard from "./ProjectCard.astro";
import { projects } from "../data/projects";
---

<section id="projects" class="section-wrapper">
  <div class="projects-header">
    <span class="section-label">Projects</span>
    <a href="/projects" class="view-all-link">
      View all projects
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
        <polyline points="15 3 21 3 21 9"/>
        <line x1="10" y1="14" x2="21" y2="3"/>
      </svg>
    </a>
  </div>

  <!-- Search bar -->
  <div class="search-wrapper">
    <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="11" cy="11" r="8"/>
      <path d="m21 21-4.35-4.35"/>
    </svg>
    <input
      id="project-search"
      type="text"
      placeholder="Search by tag or title..."
      autocomplete="off"
    />
  </div>

  <!-- Filter chips -->
  <div class="filter-chips" role="group" aria-label="Filter by category">
    {["All", "AI", "Cybersecurity", "AI Security", "Others"].map(cat => (
      <button
        class={`filter-chip ${cat === "All" ? "active" : ""}`}
        data-filter={cat}
        aria-pressed={cat === "All" ? "true" : "false"}
      >
        {cat}
      </button>
    ))}
  </div>

  <!-- Count -->
  <p id="project-count" class="project-count"></p>

  <!-- Cards -->
  <div id="project-list">
    {projects.map(project => (
      <div
        class="project-item"
        data-title={project.title.toLowerCase()}
        data-tags={project.tags.map(t => t.toLowerCase()).join(",")}
        data-categories={project.tags.filter(t =>
          ["AI","Cybersecurity","AI Security","Others"].includes(t)
        ).join(",")}
      >
        <ProjectCard project={project} />
      </div>
    ))}
  </div>
</section>

<style>
  .section-wrapper {
    max-width: 720px;
    margin: 0 auto;
  }

  .projects-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .view-all-link {
    font-size: 12px;
    color: var(--accent);
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: opacity 0.12s;
  }

  .view-all-link:hover {
    opacity: 0.75;
  }

  /* Search */
  .search-wrapper {
    position: relative;
    margin-bottom: 14px;
  }

  .search-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-tertiary);
    pointer-events: none;
  }

  #project-search {
    width: 100%;
    padding: 9px 14px 9px 34px;
    background: var(--surface);
    border: 0.5px solid var(--border);
    border-radius: var(--radius-chip);
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    color: var(--text-primary);
    outline: none;
    transition: border-color 0.12s;
  }

  #project-search:focus {
    border-color: var(--accent-border);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.08);
  }

  /* Filter chips */
  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 16px;
  }

  .filter-chip {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 400;
    padding: 4px 14px;
    border-radius: 99px;
    border: 0.5px solid var(--border);
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    transition: background 0.12s, color 0.12s, border-color 0.12s, font-weight 0.12s;
  }

  .filter-chip.active {
    background: var(--accent-bg);
    color: var(--accent-text);
    border-color: var(--accent-border);
    font-weight: 500;
  }

  .filter-chip:hover:not(.active) {
    background: var(--surface);
  }

  /* Count */
  .project-count {
    font-size: 12px;
    color: var(--text-tertiary);
    margin-bottom: 10px;
  }

  /* Hidden items */
  .project-item.hidden {
    display: none;
  }
</style>

<script>
  const searchInput = document.getElementById("project-search") as HTMLInputElement;
  const countEl     = document.getElementById("project-count")!;
  const items       = document.querySelectorAll<HTMLElement>(".project-item");
  const chips       = document.querySelectorAll<HTMLButtonElement>(".filter-chip");

  let activeFilter = "All";

  function updateProjects() {
    const query = searchInput.value.toLowerCase().trim();
    let visible = 0;

    items.forEach(item => {
      const title      = item.dataset.title ?? "";
      const tags       = item.dataset.tags ?? "";
      const categories = item.dataset.categories ?? "";

      const matchesSearch = !query || title.includes(query) || tags.includes(query);
      const matchesFilter =
        activeFilter === "All" ||
        categories.toLowerCase().includes(activeFilter.toLowerCase());

      const show = matchesSearch && matchesFilter;
      item.classList.toggle("hidden", !show);
      if (show) visible++;
    });

    countEl.textContent = `${visible} project${visible !== 1 ? "s" : ""}`;
  }

  // Filter chips
  chips.forEach(chip => {
    chip.addEventListener("click", () => {
      chips.forEach(c => {
        c.classList.remove("active");
        c.setAttribute("aria-pressed", "false");
      });
      chip.classList.add("active");
      chip.setAttribute("aria-pressed", "true");
      activeFilter = chip.dataset.filter ?? "All";
      updateProjects();
    });
  });

  // Search
  searchInput.addEventListener("input", updateProjects);

  // Init
  updateProjects();
</script>
