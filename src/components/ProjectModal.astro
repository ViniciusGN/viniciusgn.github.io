---
import '../styles/ProjectModal.css'
---

<div id="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="modal-title">
  <div id="modal-card">
    <button id="modal-close-x" aria-label="Close">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>

    <div id="modal-category-row">
      <span id="modal-dot"></span>
      <span id="modal-category-label"></span>
    </div>

    <h2 id="modal-title"></h2>
    <p id="modal-description"></p>

    <div id="modal-demo-banner">
      <p>This project has a dedicated interactive web demo with live simulations.</p>
    </div>

    <div id="modal-tags"></div>

    <div id="modal-actions">
      <button id="modal-btn-close" class="btn btn-ghost">Close</button>
      <a id="modal-btn-github" href="#" target="_blank" rel="noopener" class="btn btn-secondary">
        GitHub ↗
      </a>
      <a id="modal-btn-demo" href="#" target="_blank" rel="noopener" class="btn btn-primary" style="display:none">
        See demo →
      </a>
    </div>
  </div>
</div>

<script>
  import '../scripts/ProjectModal.js'
</script>