    title: "DevSecOps",
    provider: "TryHackMe",
    hours: "45h",
    logo: "/images/profile/courses/thm_devsecops.svg",
    highlights: [
      "Integrating security into CI/CD pipelines and the SSDLC.",
      "Automated security testing, vulnerability scanning and container security.",
      "Security automation practices for modern development workflows.",
    ],
    tools: ["Docker", "GitHub Actions", "OWASP ZAP", "SAST", "DAST"],
