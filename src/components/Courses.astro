  },
  {
    title: "Self-Driving Cars Specialization",
    provider: "Coursera / University of Toronto",
    hours: "130h",
    logo: "/images/profile/courses/drivingcars.png",
    highlights: [
      "Perception, localization, state estimation and sensor fusion.",
      "Motion planning, vehicle control and autonomous navigation.",
      "Practical projects using autonomous driving datasets.",
    ],
    tools: ["Python", "NumPy", "OpenCV", "Kalman Filters", "Vehicle Simulation"],
    link: "https://www.coursera.org/specializations/self-driving-cars",
    progress: { completed: 1, total: 4 },
  },
