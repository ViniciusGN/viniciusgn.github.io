---
// Courses.astro

interface Course {
  title: string;
  provider: string;
  hours?: string;
  logo?: string;
  highlights: string[];
  tools: string[];
  link?: string;
  certificateImage?: string;
  progress?: {
    completed: number;
    total: number;
  };
}

const courses: Course[] = [
