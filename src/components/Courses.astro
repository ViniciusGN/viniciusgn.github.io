    ],
    tools: [],
  },
    {
    title: "Associate AI Engineer for Developers",
    provider: "DataCamp",
    hours: "26h",
    logo: "/images/profile/courses/datacamp-logo.png",
    highlights: [
      "Building AI-powered software applications with LLM integration.",
      "Semantic search, chatbots, and recommendation systems.",
      "Prompt engineering and AI application design using modern frameworks.",
    ],
    tools: ["Python", "OpenAI", "LangChain", "Hugging Face", "Pinecone"],
    link: "https://www.datacamp.com/certification/ai-engineer-for-developers-associate",
    progress: { completed: 5, total: 10 },
  },
  {
    title: "Google Project Management Professional Certificate",
    provider: "Google / Coursera",
    hours: "140h",
    logo: "/images/profile/courses/google_pi_logo.png",
    highlights: [
      "Project planning, execution, monitoring and stakeholder communication.",
      "Agile and Scrum methodologies with practical case studies.",
      "Risk management, documentation and project simulations.",
    ],
    tools: ["Jira", "Asana", "Google Workspace"],
