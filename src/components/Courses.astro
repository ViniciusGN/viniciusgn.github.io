    hours: "180h",
    logo: "/images/profile/courses/google_cybersec.png",
    highlights: [
      "Foundational cybersecurity, threat detection and incident response.",
      "Security monitoring, SIEM analysis and network security fundamentals.",
      "Hands-on security investigations and automation with Python.",
    ],
    tools: ["Linux", "Python", "SQL", "SIEM", "Wireshark", "IDS/IPS"],
    link: "https://www.coursera.org/professional-certificates/google-cybersecurity",
  },
  {
    title: "Associate AI Engineer for Data Scientists",
