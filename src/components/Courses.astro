---

<section id="courses">
  <span class="section-label">Courses & Training</span>
  <div class="course-grid">
    {courses.map((course, i) => (
      <button
        class="course-card"
        data-course={i}
        aria-label={`Open details for ${course.title}`}
      >
        <div class="course-logo-wrap">
          {course.logo
            ? <img src={course.logo} alt={course.provider} class="course-logo" />
            : <span class="course-logo-initials">{course.provider.slice(0, 2).toUpperCase()}</span>
          }
          {course.progress && course.progress.completed < course.progress.total && (
            <span class="course-badge">In progress</span>
          )}
        </div>
        <div class="course-info">
          <span class="course-title">{course.title}</span>
          <span class="course-meta">{course.provider}{course.hours ? ` · ${course.hours}` : ""}</span>
        </div>
      </button>
    ))}
  </div>
</section>

<!-- Course Modal -->
<div id="course-overlay" role="dialog" aria-modal="true" aria-labelledby="course-modal-title">
  <div id="course-modal">
    <button id="course-close" aria-label="Close">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>

    <button id="course-back" aria-label="Back to course details">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
      </svg>
    </button>

    <div id="course-view-description">
      <div class="course-modal-header">
        <div class="cm-image-wrap">
          <img id="cm-course-image" class="cm-course-image" src="" alt="" />
          <span id="cm-course-initials" class="cm-course-initials"></span>
        </div>
        <div>
          <div id="cm-provider"></div>
          <h2 id="course-modal-title"></h2>
          <div id="cm-hours"></div>
        </div>
      </div>

      <div id="cm-progress-wrap" class="cm-progress-wrap">
        <div class="cm-progress-label">
          <span id="cm-progress-fraction"></span>
          <span id="cm-progress-percent"></span>
        </div>
        <div class="cm-progress-track">
          <div id="cm-progress-fill" class="cm-progress-fill"></div>
        </div>
      </div>

      <ul id="cm-highlights"></ul>

      <div id="cm-tools-wrap">
        <div id="cm-tools"></div>
      </div>

      <div class="course-modal-actions">
        <button id="cm-close-btn" class="btn btn-ghost">Close</button>
        <button id="cm-view-certificate" class="btn btn-secondary" style="display:none">
          View Certificate
        </button>
        <a id="cm-link" href="#" target="_blank" rel="noopener" class="btn btn-primary" style="display:none">
          View course ↗
        </a>
      </div>
    </div>

    <div id="course-view-certificate">
      <img id="cm-certificate-img" src="" alt="Certificate" />
    </div>
  </div>
</div>

<script id="course-data" type="application/json" is:inline set:html={JSON.stringify(courses)} />

<script is:inline>
(function () {
  var courses = JSON.parse(document.getElementById('course-data').textContent);
  var overlay = document.getElementById('course-overlay');
  var cards   = document.querySelectorAll('.course-card');

  function open(i) {
    var c = courses[i];
    document.getElementById('course-modal-title').textContent = c.title;
    document.getElementById('cm-provider').textContent = c.provider;
    document.getElementById('cm-hours').textContent = c.hours || '';

    // Header image — static elements toggled via JS (not innerHTML),
    // so component-scoped CSS below applies reliably to any source image size.
    var imgEl = document.getElementById('cm-course-image');
    var initEl = document.getElementById('cm-course-initials');
    if (c.logo) {
      imgEl.src = c.logo;
      imgEl.alt = c.title;
      imgEl.style.display = 'block';
      initEl.style.display = 'none';
    } else {
      imgEl.removeAttribute('src');
      imgEl.style.display = 'none';
      initEl.style.display = 'flex';
      initEl.textContent = c.provider.slice(0, 2).toUpperCase();
    }

    var hl = document.getElementById('cm-highlights');
    hl.innerHTML = '';
    c.highlights.forEach(function(h) {
      var li = document.createElement('li');
      li.textContent = h;
      hl.appendChild(li);
    });

    var toolsWrap = document.getElementById('cm-tools-wrap');
    var toolsEl   = document.getElementById('cm-tools');
    toolsEl.innerHTML = '';
    if (c.tools && c.tools.length) {
      c.tools.forEach(function(t) {
        var span = document.createElement('span');
        span.className = 'tag';
        span.textContent = t;
        toolsEl.appendChild(span);
      });
      toolsWrap.style.display = 'block';
    } else {
      toolsWrap.style.display = 'none';
    }

    var link = document.getElementById('cm-link');
    if (c.link) {
      link.href = c.link;
      link.style.display = 'inline-flex';
    } else {
      link.style.display = 'none';
    }

    var certBtn = document.getElementById('cm-view-certificate');
    var certImg = document.getElementById('cm-certificate-img');
    if (c.certificateImage) {
      certBtn.style.display = 'inline-flex';
      certImg.src = c.certificateImage;
      certImg.alt = c.title + ' certificate';
    } else {
      certBtn.style.display = 'none';
      certImg.src = '';
    }

    // Progress bar — only shown while completed < total.
    // Once a course is finished (completed === total, or no progress field
    // at all) the bar is hidden and the image stays clean.
    var progressWrap = document.getElementById('cm-progress-wrap');
    if (c.progress && c.progress.completed < c.progress.total) {
      var pct = Math.round((c.progress.completed / c.progress.total) * 100);
      document.getElementById('cm-progress-fraction').textContent = c.progress.completed + '/' + c.progress.total + ' modules';
      document.getElementById('cm-progress-percent').textContent = pct + '%';
      document.getElementById('cm-progress-fill').style.width = pct + '%';
      progressWrap.style.display = 'block';
    } else {
      progressWrap.style.display = 'none';
    }

    showDescriptionView();
    overlay.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function showCertificateView() {
    var modal = document.getElementById('course-modal');
    modal.classList.add('certificate-view');
  }

  function showDescriptionView() {
    var modal = document.getElementById('course-modal');
    modal.classList.remove('certificate-view');
  }

  function close() {
    overlay.classList.remove('active');
    document.body.style.overflow = '';
    showDescriptionView();
  }

  cards.forEach(function(card) {
    card.addEventListener('click', function() {
      open(parseInt(card.dataset.course));
    });
  });

  document.getElementById('course-close').addEventListener('click', close);
  document.getElementById('cm-close-btn').addEventListener('click', close);
  document.getElementById('cm-view-certificate').addEventListener('click', showCertificateView);
  document.getElementById('course-back').addEventListener('click', showDescriptionView);
  overlay.addEventListener('click', function(e) {
    if (e.target === overlay) close();
  });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') close();
  });
})();
</script>

<style>
  .course-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }

  .course-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    border: 0.5px solid var(--border);
    border-radius: 12px;
    background: var(--bg);
    text-align: left;
    cursor: pointer;
    font-family: inherit;
    transition: border-color 0.15s, box-shadow 0.15s;
    width: 100%;
  }

  .course-card:hover {
    border-color: var(--border-hover);
    box-shadow: 0 0 0 4px var(--accent-bg);
  }

  .course-logo-wrap {
    position: relative;
    flex-shrink: 0;
    width: 56px;
    height: 56px;
  }

  .course-logo,
  .course-logo-initials {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 1.5px solid var(--accent-border);
    box-shadow: 0 0 0 3px var(--bg), 0 0 0 5px var(--accent-border);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
  }

  .course-logo {
    object-fit: cover;
  }

  .course-logo-initials {
    font-size: 12px;
    font-weight: 600;
    color: var(--accent-text);
  }

  /* "In progress" badge — same pattern as Certifications' cert-badge,
     anchored to the bottom edge of the circular logo. */
  .course-badge {
    position: absolute;
    bottom: -4px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 9px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--surface);
    color: var(--text-tertiary);
    border: 0.5px solid var(--border);
    border-radius: 99px;
    padding: 1px 6px;
    white-space: nowrap;
  }

  .course-info {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .course-title {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-primary);
    line-height: 1.4;
  }

  .course-meta {
    font-size: 12px;
    color: var(--text-secondary);
  }

  /* Modal */
  #course-overlay {
    position: fixed;
    inset: 0;
    z-index: 999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: var(--overlay);
    backdrop-filter: blur(2px);
  }

  #course-overlay.active {
    display: flex;
  }

  #course-modal {
    position: relative;
    width: min(100%, 560px);
    max-height: calc(100vh - 48px);
    overflow-y: auto;
    padding: 28px;
    border-radius: 20px;
    background: var(--modal-bg);
    border: 0.5px solid var(--border);
    box-shadow: 0 24px 80px rgba(0,0,0,0.18);
    transition: width 0.28s ease, max-width 0.28s ease;
  }

  #course-modal.certificate-view {
    width: min(100%, 900px);
  }

  #course-close {
    position: absolute;
    top: 16px;
    right: 18px;
    border: none;
    background: transparent;
    cursor: pointer;
    color: var(--text-secondary);
    width: 32px;
    height: 32px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.12s;
  }

  #course-close:hover {
    background: var(--surface);
  }

  /* Back button — only visible in certificate view, replaces the
     concept of "closing" with "returning" to the course description */
  #course-back {
    position: absolute;
    top: 16px;
    left: 18px;
    border: none;
    background: transparent;
    cursor: pointer;
    color: var(--text-secondary);
    width: 32px;
    height: 32px;
    border-radius: 8px;
    display: none;
    align-items: center;
    justify-content: center;
    transition: background 0.12s;
  }

  #course-back:hover {
    background: var(--surface);
  }

  #course-modal.certificate-view #course-back {
    display: flex;
  }

  #course-modal.certificate-view #course-close {
    display: none;
  }

  #course-view-description {
    display: block;
  }

  #course-modal.certificate-view #course-view-description {
    display: none;
  }

  #course-view-certificate {
    display: none;
    padding-top: 8px;
  }

  #course-modal.certificate-view #course-view-certificate {
    display: block;
  }

  #cm-certificate-img {
    width: 100%;
    display: block;
    border-radius: 12px;
    border: 0.5px solid var(--border);
  }

  .course-modal-header {
    display: flex;
    align-items: flex-start;
    gap: 18px;
    margin-bottom: 18px;
    padding-right: 32px;
  }

  /* Standardized course image container — fixed size, slightly rounded
     square, object-fit: cover. Same box regardless of the source image's
     native dimensions (banner illustration, small badge, SVG, whatever). */
  .cm-image-wrap {
    width: 120px;
    height: 120px;
    border-radius: 14px;
    overflow: hidden;
    flex-shrink: 0;
    border: 0.5px solid var(--border);
    background: var(--surface);
  }

  .cm-course-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cm-course-initials {
    width: 100%;
    height: 100%;
    display: none;
    align-items: center;
    justify-content: center;
    font-size: 28px;
    font-weight: 600;
    color: var(--accent-text);
    background: var(--accent-bg);
  }

  #cm-provider {
    font-size: 12px;
    color: var(--accent);
    margin-bottom: 4px;
  }

  #course-modal-title {
    font-size: 17px;
    font-weight: 500;
    color: var(--text-primary);
    line-height: 1.35;
    margin-bottom: 4px;
  }

  #cm-hours {
    font-size: 12px;
    color: var(--text-tertiary);
  }

  /* Progress bar — only shown for courses with completed < total.
     Sits between the header and the highlights, above the description text. */
  .cm-progress-wrap {
    display: none;
    margin: 0 0 18px;
  }

  .cm-progress-label {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    color: var(--text-tertiary);
    margin-bottom: 6px;
  }

  .cm-progress-track {
    height: 6px;
    border-radius: 3px;
    background: var(--surface);
    border: 0.5px solid var(--border);
    overflow: hidden;
  }

  .cm-progress-fill {
    height: 100%;
    width: 0%;
    background: var(--accent);
    border-radius: 3px;
    transition: width 0.25s ease;
  }

  #cm-highlights {
    list-style: none;
    padding: 0;
    margin: 0 0 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  #cm-highlights li {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.7;
    padding-left: 14px;
    position: relative;
  }

  #cm-highlights li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 9px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }

  #cm-tools-wrap {
    margin-bottom: 18px;
  }

  #cm-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }

  .course-modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
  }

  @media (max-width: 760px) {
    .course-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 540px) {
    .course-grid {
      grid-template-columns: 1fr;
    }

    .cm-image-wrap {
      width: 88px;
      height: 88px;
      border-radius: 12px;
    }

    .cm-course-initials {
      font-size: 20px;
    }

    .course-modal-actions {
      flex-direction: column-reverse;
      align-items: stretch;
    }

    .course-modal-actions .btn {
      justify-content: center;
    }
  }
</style>