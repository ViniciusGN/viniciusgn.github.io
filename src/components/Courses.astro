    link: "https://tcm-sec.com/academy/beginners-guide-to-iot-and-hardware-hacking/",
  },
  {
    title: "Advanced Cybersecurity for ICS (ICS300)",
    provider: "CISA",
    hours: "14h",
    logo: "/images/profile/courses/cisa_ics300.png",
    highlights: [
