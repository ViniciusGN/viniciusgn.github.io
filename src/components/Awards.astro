---
// Awards.astro

const awards = [
  {
    year: "2021",
    title: "Medalha do Serviço Amazônico — Bronze Clasp",
    subtitle: "Brazilian Army. Awarded for two years of effective service in the Brazilian Legal Amazon region as a Communications Officer at the 23rd Jungle Signal Company, Marabá, Pará.",
  },
  {
    year: "2018",
    title: "Medalha-Prêmio Coronel Correia Lima",
    subtitle: "Brazilian Army. Awarded to the 1st-place graduate of the Reserve Officers Training Course, in recognition of academic excellence, leadership performance and exemplary conduct.",
  },
  {
    year: "2024",
    title: "BRAFITEC International Scholarship",
    subtitle: "Brazil-France university exchange programme (CAPES/Campus France). Merit-based scholarship awarded for the double-degree M.Sc. at ENSICAEN, Caen, France.",
  },
];
---

<section id="awards">
  <span class="section-label">Awards & Recognition</span>
  <div class="award-list">
    {awards.map(({ year, title, subtitle }) => (
      <div class="award-item">
        <div class="award-year">{year}</div>
        <div class="award-body">
          <div class="award-title">{title}</div>
          <div class="award-sub">{subtitle}</div>
        </div>
      </div>
    ))}
  </div>
</section>