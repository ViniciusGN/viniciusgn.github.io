---
// ResearchInterests.astro

const researchText = `
My research interests lie at the intersection of Artificial Intelligence,
Cybersecurity, and Communication Networks, with a focus on AI Security,
Cyber Threat Intelligence, Mobile Network Security (5G/6G), IoT and Smart
Infrastructure Security, and the protection of large-scale distributed and
autonomous systems. I am particularly interested in applying machine learning
and intelligent systems to enhance threat detection, cyber defense, and the
security of next-generation networked environments.
`;
---

<div class="research-box">
  <span class="research-label">Research Interests</span>

  <p class="research-paragraph">
    {researchText}
  </p>
</div>

<style>
  .research-box {
    margin-top: 20px;
    padding: 16px 20px;
    border-radius: 12px;
    border: 0.5px solid var(--accent-border);
    background: var(--accent-bg);
  }

  .research-label {
    display: block;
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-text);
    margin-bottom: 12px;
  }

  .research-paragraph {
    margin: 0;
    font-size: 13px;
    line-height: 1.7;
    color: var(--accent-text);
    opacity: 0.9;
  }
</style>