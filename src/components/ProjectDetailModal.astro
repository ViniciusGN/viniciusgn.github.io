---
import '../styles/ProjectDetailModal.css'
---

<div id="detail-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="detail-modal-title">
  <div id="detail-modal-card">
    <button id="detail-modal-close-x" aria-label="Close">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>

    <div id="detail-modal-scroll">
      <div id="detail-modal-category-row">
        <span id="detail-modal-dot"></span>
        <span id="detail-modal-category-label"></span>
      </div>

      <h2 id="detail-modal-title"></h2>

      <div id="detail-modal-description"></div>

      <div id="detail-modal-team-row"></div>

      <div id="detail-modal-institutions-row"></div>

      <div id="detail-modal-images"></div>

      <div id="detail-modal-sections"></div>

      <div id="detail-modal-highlights-wrap">
        <span class="detail-modal-subheading">Highlights</span>
        <ul id="detail-modal-highlights"></ul>
      </div>

      <div id="detail-modal-tags"></div>
    </div>

    <div id="detail-modal-actions">
      <button id="detail-modal-btn-close" class="btn btn-ghost">Close</button>
      <a id="detail-modal-btn-github" href="#" target="_blank" rel="noopener" class="btn btn-secondary">
        GitHub ↗
      </a>
    </div>
  </div>
</div>

<script>
  import '../scripts/ProjectDetailModal.js'
</script>